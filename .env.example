# =============================================================================
# app_server — runtime configuration (EXAMPLE)
#
# The deliverable is the compiled `app_server` binary. It ships with NO secrets
# and NO config baked in. Everything it needs to run is supplied here at runtime.
#
# Usage (place beside the binary, or point to it):
#   cp .env.example .env         # then fill in the values below
#   docker run --env-file .env ... app_server
# or the binary auto-reads a `.env` next to it / at $ENV_FILE.
#
# NEVER commit a filled-in .env — it contains live secrets. Only this example
# (placeholder values) belongs in git.
# =============================================================================

# ----------------------------------------------------------------------------
# SECRETS  (injected at runtime — the real keys, never shipped in the artifact)
# ----------------------------------------------------------------------------
# Decrypts the CodeEnigma-encrypted licensing module (licensing.enc) baked into
# the binary. Without it the app still starts and serves everything EXCEPT
# /api/license. Must be the SAME key used at build time to encrypt licensing.enc.
CODE_DECRYPT_KEY=replace-with-build-time-fernet-key

# Django signing key (sessions, CSRF, tokens). Pick ONCE, keep stable across runs
# or existing sessions break. Any long random string.
DJANGO_SECRET_KEY=replace-with-long-random-string

# Fernet key that encrypts/decrypts protected DB field values. Pick ONCE and keep
# stable, or previously-encrypted rows become unreadable. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-fernet-key

# Alternative to the three vars above: point to a file (e.g. a tmpfs/secrets
# mount) containing KEY=VALUE lines. Loaded once at startup, then the source is
# shredded + unlinked and scrubbed from the environment. Leave unset to use the
# individual vars above.
#KEYS_FILE=/run/keys/app.env

# ----------------------------------------------------------------------------
# DATABASE  (primary Postgres — the client's or one you provision)
# ----------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=test_obs
DB_USER=obs_user
DB_PASSWORD=replace-with-db-password

# ----------------------------------------------------------------------------
# TENANT DATABASE  (optional second connection; unset to reuse the primary)
# ----------------------------------------------------------------------------
#TENANT_DB_HOST=postgres
#TENANT_DB_PORT=5432
#TENANT_DB_USER=obs_user
#TENANT_DB_PASSWORD=replace-with-db-password

# ----------------------------------------------------------------------------
# SERVER / RUNTIME
# ----------------------------------------------------------------------------
BIND_HOST=0.0.0.0
BIND_PORT=8000

# Empty/silent by default. Set to INFO or DEBUG only when you need logs.
#LOG_LEVEL=

# Run DB migrations on startup. Set to 1 for the FIRST deploy against an empty
# database; leave unset afterwards so startup is fast and idempotent.
#MIGRATE_ON_START=1

# Explicit path to the env file, if not placed beside the binary / not --env-file.
#ENV_FILE=/path/to/.env
